# То же, что backend/.env, но для справки при Docker: в compose хосты db/redis подставляются автоматически.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/legal_ai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
SECRET_KEY=dev-super-secret-key-change-in-production-32chars-2026-legal-ai-xyz789!!!
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# На текущем рабочем сервере: CORS_ORIGINS=["https://135-106-163-146.nip.io"]
SERVER_PUBLIC_IP=135.106.163.146
# Только для необязательного профиля Traefik: укажите проверенный домен API.
TRAEFIK_API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com
LAW_CHANGE_SOURCES=https://www.consultant.ru/law/review/fed/updprof/

# SaluteSpeech (голосовой ввод в чате). Можно те же Client ID/Secret, что у GigaChat, если в кабинете включён SaluteSpeech.
# SALUTE_SPEECH_CLIENT_ID=
# SALUTE_SPEECH_CLIENT_SECRET=
# SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
# SALUTE_SPEECH_SAMPLE_RATE=16000
