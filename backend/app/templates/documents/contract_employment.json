    {
      "text": "{{job_function}}",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "Характер занятости: {{employment_type}}.",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "Работник лично выполняет согласованную трудовую функцию и соблюдает правила внутреннего трудового распорядка. Работодатель предоставляет обусловленную договором работу и обеспечивает условия труда в соответствии с трудовым законодательством.",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "2 Начало работы и срок договора",
      "role": "heading",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "Дата начала работы: {{start_date}}.",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "Договор заключён на неопределённый срок.",
      "role": "body",
      "when_field": "term_type",
      "when_status": null,
      "when_value": "на неопределённый срок",
      "when_values": null
    },
    {
      "text": "Срок и основание срочного договора: {{fixed_term}}.",
      "role": "body",
      "when_field": "term_type",
      "when_status": null,
      "when_value": "срочный",
      "when_values": null
    },
    {
      "text": "Условие об испытании: {{probation}}.",
      "role": "body",
      "when_field": "probation",
      "when_status": "filled",
      "when_value": null,
      "when_values": null
    },
    {
      "text": "3 Оплата труда",
      "role": "heading",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "Размер оклада или ставки заработной платы до удержания НДФЛ: {{amount}}.",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "{{pay_conditions}}",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "Дни и способ выплаты заработной платы: {{payment}}.",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "Заработная плата выплачивается не реже чем каждые полмесяца в сроки, установленные в соответствии с трудовым законодательством.",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "4 Рабочее время и отдых",
      "role": "heading",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
