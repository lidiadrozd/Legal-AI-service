    },
    {
      "text": "1 Предмет договора",
      "role": "heading",
      "when_field": null,
      "when_status": null,
      "when_value": null,
      "when_values": null
    },
    {
      "text": "Должность Работника: {{position}}. Место работы: {{workplace}}.",
      "role": "body",
      "when_field": null,
      "when_status": null,
      "when_value": null,
