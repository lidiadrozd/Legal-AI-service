      "when_field": null,
      "when_value": null,
      "when_status": null,
      "when_values": null
    },
    {
      "text": "3.1. Ежемесячная плата за наём составляет {{amount}}.",
      "role": "body",
      "when_field": null,
      "when_value": null,
      "when_status": null,
      "when_values": null
