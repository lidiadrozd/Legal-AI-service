      "role": "body",
      "when_field": null,
      "when_value": null,
      "when_status": null,
      "when_values": null
    },
    {
      "text": "3.3. Коммунальные и прочие платежи: {{utilities}}",
      "role": "body",
      "when_field": null,
      "when_value": null,
      "when_status": null,
      "when_values": null
