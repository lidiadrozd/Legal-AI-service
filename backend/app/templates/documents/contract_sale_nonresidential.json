      "when_value": null,
      "when_status": null,
      "when_values": null
    },
    {
      "text": "Сведения об обременениях и правах третьих лиц: {{encumbrances}}. Сведения о правах на земельный участок, относящиеся к сделке: {{land_rights}}.",
      "role": "body",
      "when_field": null,
      "when_value": null,
      "when_status": null,
      "when_values": null
