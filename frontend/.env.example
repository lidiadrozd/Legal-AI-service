# Локально: оставьте пустым — используется /api и прокси Vite (см. vite.config.ts).
# Прямой вызов VPS без прокси (только если фронт тоже по HTTP или нет mixed content):
# VITE_API_BASE_URL=http://87.242.87.53:8000
#
# Vercel / любой HTTPS-сайт: либо пусто + rewrites в vercel.json на бэкенд,
# либо VITE_API_BASE_URL=https://… (обязательно HTTPS).
