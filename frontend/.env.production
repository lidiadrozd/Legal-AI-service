# Сборка для Vercel (HTTPS): не задавайте VITE_API_BASE_URL — клиент ходит на тот же хост /api/…,
# а vercel.json проксирует запросы на бэкенд (без блокировки mixed content).
# Для другого сервера API укажите полный URL, обязательно HTTPS, если фронт по HTTPS:
# VITE_API_BASE_URL=https://ваш-api.example.com
